{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(sonar-scanner:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "APP_ENV": "development",
    "MSSQL_DATABASE": "datapulse_erp",
    "POSTGRES_DATABASE": "datapulse_analytics"
  }
}
