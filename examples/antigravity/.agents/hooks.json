{
  "lint-on-change": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check src tests --quiet || true",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "sql-injection-guard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/sql-guard.py src",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
