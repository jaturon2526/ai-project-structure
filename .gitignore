# ==============================================================================
# Git Ignore Configuration for AI-Project-Structure Master Repository
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python & Virtual Environments (Do NOT track .venv in git)
.venv/
**/.venv/
**/.venv/**
venv/
**/venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage/
*.cover
.hypothesis/
.pytest_cache/

# SonarQube & Linters
.scannerwork/
.eslintcache
.ruff_cache/
.mypy_cache/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
token.json
credentials.json
# Allow example environment files
!.env.example

# IDE specific files
.idea/
*.swp
*.swo

# Temporary & Log files
*.log
tmp/
temp/
scratch/

# ==============================================================================
# Explicitly Track AI Customization Folders & Hidden Configs
# (Ensure git never ignores template configurations)
# ==============================================================================
!.claude/
!.claude/**
!.claudeignore
!.agents/
!.agents/**
!.geminiignore
!.mcp.json
!CLAUDE.local.md.example
