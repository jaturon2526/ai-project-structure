# Claude Ignore File
# Specifies files and directories that Claude Code should ignore.

# Dependencies
node_modules/
vendor/
.venv/
env/
__pycache__/
*.pyc

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
token.json
secrets.*

# Build Outputs & Bundles
dist/
build/
out/
.next/
.nuxt/
target/
*.o
*.so
*.dylib

# Version Control & IDE
.git/
.svn/
.hg/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Cache
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.eslintcache
.turbo/
.cache/
coverage/
.nyc_output/

# Temporary / Scratch files
tmp/
temp/
scratch/
